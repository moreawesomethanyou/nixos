// Панель стационарного компьютера.
//
// Близнец config.jsonc (та — для ноутбука). Два файла, а не один, потому что
// у waybar конфиг на JSON, а в нём нельзя написать «если». Отличия ровно три:
//   * нет модулей battery и backlight — нет ни батареи, ни подсветки экрана;
//   * температура читается с k10temp (AMD), а не с coretemp (Intel);
//   * раскладку переключаем на "all", а не на конкретную клавиатуру ноутбука.
// Всё остальное совпадает: если правишь панель «для красоты» — правь оба файла.
// Стиль (style.css) общий, он один на обе машины.
{
  "layer": "top",
  "position": "top",
  "height": 28,
  "spacing": 0,

  "modules-left":   ["hyprland/workspaces", "hyprland/submap"],
  "modules-center": ["hyprland/window"],
  "modules-right":  ["tray", "idle_inhibitor", "custom/lang", "bluetooth", "network", "pulseaudio", "cpu", "memory", "temperature", "power-profiles-daemon", "clock"],

  "hyprland/workspaces": {
    "format": "{id}",
    "on-click": "activate",
    "sort-by-number": true,
    "persistent-workspaces": { "*": 5 }
  },

  "hyprland/window": {
    "format": "{}",
    "max-length": 60,
    "separate-outputs": true
  },

  "tray": { "icon-size": 16, "spacing": 8 },

  // Язык: EN / RU / JA. Скрипт печатает новую строку только по событию —
  // смене раскладки в Hyprland или переключению mozc, без опроса по таймеру.
  // Клавиатура здесь внешняя и называться может как угодно, поэтому "all":
  // Hyprland переключит раскладку сразу на всех клавиатурах.
  "custom/lang": {
    "exec": "~/.local/bin/lang-indicator",
    "return-type": "json",
    "format": "{}",
    "on-click": "hyprctl switchxkblayout all next",
    "on-click-right": "sh -c 'fcitx5-remote -t; ~/.local/bin/lang-poke'"
  },

  // Режим питания: клик — по кругу, правый клик — меню.
  // На AMD профили появляются, только если работает драйвер amd_pstate
  // (см. hosts/desktop/configuration.nix). Если `powerprofilesctl get`
  // ругается — убери "power-profiles-daemon" из modules-right выше.
  "power-profiles-daemon": {
    "format": "{icon}",
    "tooltip-format": "Питание: {profile}\nДрайвер: {driver}",
    "format-icons": {
      "default":     "󰈐",
      "performance": "󰓅",
      "balanced":    "󰾅",
      "power-saver": "󰾆"
    },
    "on-click-right": "~/.local/bin/power-mode menu"
  },

  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": { "activated": "󰅶", "deactivated": "󰾪" },
    "tooltip-format-activated": "Экран не гаснет",
    "tooltip-format-deactivated": "Автогашение экрана включено"
  },

  "bluetooth": {
    "format": "󰂯",
    "format-disabled": "󰂲",
    "format-off": "󰂲",
    "format-connected": "󰂱  {num_connections}",
    "tooltip-format": "{controller_alias}\n{status}",
    "tooltip-format-connected": "{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias} {device_battery_percentage}%",
    "on-click": "blueman-manager"
  },

  "network": {
    "format-wifi": "󰤨   {signalStrength}%",
    "format-ethernet": "󰈀",
    "format-linked": "󰈀",
    "format-disconnected": "󰤭",
    "tooltip-format-wifi": "{essid}\n{ipaddr}\n↓{bandwidthDownBits} ↑{bandwidthUpBits}",
    "tooltip-format-ethernet": "{ifname}\n{ipaddr}",
    "tooltip-format-disconnected": "Нет сети",
    "on-click": "nm-connection-editor"
  },

  "pulseaudio": {
    "format": "{icon}  {volume}%",
    "format-muted": "󰝟",
    "format-bluetooth": "{icon}  {volume}%",
    "format-icons": { "headphone": "󰋋", "headset": "󰋎", "default": ["󰕿", "󰖀", "󰕾"] },
    "on-click": "pavucontrol",
    "on-scroll-up": "wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+",
    "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"
  },

  "cpu":    { "format": "󰻠  {usage}%", "interval": 3, "on-click": "kitty -e btop" },
  "memory": { "format": "󰍛  {percentage}%", "interval": 5, "tooltip-format": "{used:0.1f}G / {total:0.1f}G" },

  // Температура процессора. У AMD её даёт драйвер k10temp, но он сидит на
  // шине PCI, и номер hwmon зависит от материнской платы — заранее не угадать.
  // Поэтому перечислены варианты: waybar возьмёт первый существующий путь.
  //
  // ПОСЛЕ УСТАНОВКИ проверь, что показывает именно процессор:
  //   for f in /sys/class/hwmon/hwmon*; cat $f/name; end     # какой из них k10temp
  // и оставь в списке один нужный путь. Иначе есть шанс увидеть здесь
  // температуру видеокарты или SSD — цифры правдоподобные, но не те.
  "temperature": {
    "hwmon-path": [
      "/sys/class/hwmon/hwmon0/temp1_input",
      "/sys/class/hwmon/hwmon1/temp1_input",
      "/sys/class/hwmon/hwmon2/temp1_input",
      "/sys/class/hwmon/hwmon3/temp1_input",
      "/sys/class/hwmon/hwmon4/temp1_input",
      "/sys/class/hwmon/hwmon5/temp1_input"
    ],
    "critical-threshold": 90,
    "interval": 2,
    "format": "{temperatureC}°C ",
    "format-critical": "{temperatureC}°C "
  },

  "clock": {
    "format": "{:%H:%M %d %B (%a)}",
    "format-alt": "{:%a, %d %B %Y}",
    "tooltip-format": "<tt>{calendar}</tt>",
    "calendar": {
      "mode": "month",
      "format": { "today": "<b><u>{}</u></b>" }
    }
  }
}
