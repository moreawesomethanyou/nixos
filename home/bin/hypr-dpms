#!/usr/bin/env bash
# Надёжно включить или выключить экран.
#
# Зачем обёртка. В Hyprland 0.56 с Lua-конфигом диспетчер hl.dsp.dpms
# игнорирует свой аргумент и всегда ПЕРЕКЛЮЧАЕТ экран. Проверено: четыре
# вызова hl.dsp.dpms("on") подряд дают 1 -> 0 -> 1 -> 0. Из-за этого
# hypridle при пробуждении гасил экран той самой командой, которой
# должен был его включать.
#
# Поэтому "включить"/"выключить" делаем сами: смотрим текущее состояние
# и переключаем, только если оно не то, которое нужно.
#
# Ограничение: диспетчер действует сразу на все мониторы, поэтому скрипт
# ориентируется на первый в списке (на этом ноуте это eDP-1).
#
# Использование: hypr-dpms on | off
set -u

case "${1:-}" in
  on)  target=1 ;;
  off) target=0 ;;
  *)   echo "использование: $(basename "$0") on|off" >&2; exit 2 ;;
esac

state() { hyprctl monitors 2>/dev/null | grep -m1 dpmsStatus | tr -dc '01'; }

# Трёх попыток с запасом хватает: одного переключения достаточно,
# остальные — на случай, если команда потерялась при пробуждении.
for _ in 1 2 3; do
  [ "$(state)" = "$target" ] && exit 0
  hyprctl dispatch 'hl.dsp.dpms("toggle")' >/dev/null 2>&1
  sleep 0.4
done

[ "$(state)" = "$target" ]
