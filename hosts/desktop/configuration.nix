# NixOS — стационарный компьютер (AMD + видеокарта AMD) + Hyprland.
# Здесь только то, что отличает эту машину от ноутбука. Всё общее —
# в ../common.nix, пользовательская часть — в ../../home/roman.nix.
#
# Правь, затем: rebuild  (= sudo nixos-rebuild switch --flake ~/nixos-config)
#
# Мониторы настраиваются НЕ здесь, а в home/files/hypr/hyprland.lua,
# в разделе «МОНИТОРЫ» (там же лежит заготовка под два монитора).

{ config, pkgs, lib, inputs, ... }:

{
  imports =
    [ ./hardware-configuration.nix
      ../common.nix
    ];

  networking.hostName = "desktop";

  #############################################################
  ## Видеокарта AMD
  #############################################################
  # Драйвер amdgpu грузим ещё в initrd. Без этого монитор до самого
  # запуска графики живёт на VESA-заглушке: экран пару раз моргает и
  # переключает режим, а на некоторых картах загрузчик и tuigreet
  # показываются в неродном разрешении.
  boot.initrd.kernelModules = [ "amdgpu" ];

  # Ничего доустанавливать не нужно: OpenGL (radeonsi), Vulkan (RADV) и
  # аппаратное декодирование видео (VA-API) приходят прямо из mesa, а она
  # включена в ../common.nix через hardware.graphics.enable.
  # Проверить после установки:  vulkaninfo --summary   и   vainfo
  hardware.graphics.extraPackages = with pkgs; [
    # amdvlk       # проприетарный Vulkan AMD. Обычно не нужен и часто
                   # медленнее RADV — включать, только если конкретная
                   # игра без него не работает.
  ];
  services.pipewire.extraConfig.pipewire."92-allowed-rates" = {
  "context.properties" = {
    "default.clock.rate" = 48000;
    "default.clock.allowed-rates" = [ 44100 48000 88200 96000 ];
  };
};

  #############################################################
  ## Питание
  #############################################################
  # Профили питания (power-profiles-daemon включён в ../common.nix) на AMD
  # работают через драйвер amd_pstate в режиме EPP. На свежих ядрах он и так
  # выбирается сам для Zen 2 и новее; строка ниже — на случай, если у ядра
  # другое мнение. Если процессор старый и драйвер не поддерживается,
  # параметр просто игнорируется, система от этого не пострадает.
  #
  # Проверить:  powerprofilesctl get   — должно печатать balanced, а не ошибку.
  # Если профилей нет вовсе — убери модуль "power-profiles-daemon" из
  # home/files/waybar/config-desktop.jsonc, чтобы не занимал место в панели.
  boot.kernelParams = [ "amd_pstate=active" ];

  # Кнопку питания намеренно не переопределяем: на десктопе поведение по
  # умолчанию (короткое нажатие — корректное выключение) — то, что нужно.
  # На ноутбуке она заодно будит из сна, поэтому там всё иначе.

  #############################################################
  ## Диагностика железа
  #############################################################
  environment.systemPackages = with pkgs; [
    amdgpu_top       # что делает видеокарта: загрузка, память, частоты
    radeontop        # то же самое, но попроще и в консоли
    libva-utils      # vainfo — проверить аппаратное декодирование
    vulkan-tools     # vulkaninfo
  ];
}
